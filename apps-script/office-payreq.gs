// lane-d (Uday, 26 Nov: "payments above 5000 cannot be made in cash, they are going to be generated by Pawan Sir ... sent to Pawan Sir for
// approval and initiation of icici payments"; "each payment must still have a proof of payment irrespective of who it was for").
// A payment above the cash limit is never cash. The Fee Clerk (or anyone who pays) raises a PAYMENT REQUEST; the Finance Head (Pawan) or the
// Owner approves or rejects it, pays it through ICICI OUTSIDE the portal (the portal never moves money), then marks it paid here with the
// bank reference (and the bank proof: the UTR / ICICI confirmation or statement line). Marking it paid writes ONE bank OUT row in the Day
// Book (id 'pay-<request id>'), dated the day it was paid. With no proof file yet the row stands as "proof pending" and the day cannot
// close until the proof is attached (payreq.proof). The request, each step and the proof are append-only: PayRequests (the ask) and
// PayEvents (approved | rejected | paid | proof), the latest event is the state.
// What the payments desk (the ICICI bulk file) reads: payreq.list with state 'approved'. It must refuse to mark paid without a bank ref.

var OFFICE_PAYREQ_ROLES = ['FeeClerk', 'AdminManager', 'Principal', 'Owner'];
var OFFICE_PAYREQ_DECIDERS = ['FinanceHead', 'Owner'];

function officeFileExists_(campus, fileId) {
  return officeRecentBooks_(campus).some(function (b) {
    return officeRows_(b, 'Files').some(function (f) { return f.id === String(fileId) && f.campus === campus; });
  });
}

// every request of this school in this year's and last year's books, each with its latest event
function officePayRequests_(campus) {
  const out = [];
  officeRecentBooks_(campus).forEach(function (b) {
    const ev = {};
    officeRows_(b, 'PayEvents').forEach(function (e) { (ev[e.request_id] = ev[e.request_id] || []).push(e); });
    officeRows_(b, 'PayRequests').forEach(function (r) {
      if (r.campus !== campus) return;
      const list = (ev[r.id] || []).sort(function (a, b2) { return a.created_at < b2.created_at ? -1 : 1; });
      let state = 'requested', decidedBy = '', reason = '', bankRef = '', proof = '', entry = '', paidDate = '';
      list.forEach(function (e) {
        if (e.state === 'approved' || e.state === 'rejected') { state = e.state; decidedBy = e.created_by; reason = e.reason; }
        if (e.state === 'paid') { state = 'paid'; bankRef = e.bank_ref; entry = e.entry_id; paidDate = e.paid_date; proof = e.proof_file_id || proof; }
        if (e.state === 'proof') proof = e.proof_file_id;
      });
      out.push({ id: r.id, campus: r.campus, entry_date: r.entry_date, payee: r.payee, amount_paise: r.amount_paise, category: r.category, narration: r.narration,
        file_id: r.file_id, charged_to: r.charged_to, created_at: r.created_at, created_by: r.created_by, state: state, decided_by: decidedBy, reason: reason,
        bank_ref: bankRef, proof_file_id: proof, entry_id: entry, paid_date: paidDate, proof_pending: state === 'paid' && !proof, _book: b });
    });
  });
  return out;
}
function officePayRequestFind_(campus, id) {
  const r = officePayRequests_(campus).filter(function (x) { return x.id === String(id); })[0];
  if (!r) throw new Error('NOT_FOUND');
  return r;
}
function officePayPublic_(r) { const o = Object.assign({}, r); delete o._book; return o; }

// {id, campus, payee, amount_paise, category, narration?, file_id (the supplier's bill), charged_to?} -> {id, duplicate}
function officePayRequestAdd_(ctx, data) {
  if (!data.id) throw new Error('MISSING_ID');
  const ss = officeRecentBooks_(data.campus)[0], id = String(data.id);
  if (officePayRequests_(data.campus).some(function (r) { return r.id === id; })) return { id: id, duplicate: true };
  const payee = String(data.payee || '').trim();
  if (payee.length < 2 || payee.length > 200) throw officeCoded_('PAYEE_REQUIRED');
  if (typeof data.amount_paise !== 'number' || !Number.isSafeInteger(data.amount_paise) || data.amount_paise < 100) throw new Error('BAD_AMOUNT');
  const cat = officeCategory_(data.category);
  if (!cat || cat.direction !== 'OUT' || cat.active === false) throw new Error('BAD_CATEGORY');
  if (!data.file_id) throw officeCoded_('FILE_REQUIRED');             // the bill: what the payment is for
  if (!officeFileExists_(data.campus, data.file_id)) throw officeCoded_('FILE_MISSING');
  const chargedTo = String(data.charged_to || data.campus);
  officeAppend_(ss, 'PayRequests', { id: id, campus: data.campus, entry_date: officeToday_(), payee: payee, amount_paise: data.amount_paise, category: cat.id,
    narration: String(data.narration || '').trim().slice(0, 300), file_id: String(data.file_id), charged_to: chargedTo }, ctx.caller, { action: 'payreq.add', campus: data.campus });
  return { id: id, duplicate: false };
}

// {campus, state?} -> {requests, limit_paise}
function officePayRequestList_(ctx, data) {
  const rows = officePayRequests_(data.campus).filter(function (r) { return !data.state || r.state === data.state || (data.state === 'proof_pending' && r.proof_pending); });
  return { requests: rows.map(officePayPublic_).sort(function (a, b) { return a.created_at < b.created_at ? 1 : -1; }), limit_paise: officeApprovalLimit_(data.campus) };
}

function officePayEvent_(ctx, r, id, state, extra) {
  return officeAppend_(r._book, 'PayEvents', Object.assign({ id: String(id), campus: r.campus, request_id: r.id, state: state, reason: '', bank_ref: '', proof_file_id: '', paid_date: '', entry_id: '' }, extra || {}),
    ctx.caller, { action: 'payreq.' + state, campus: r.campus });
}

// {id (this decision's), request_id, approve: boolean, reason?} -> {request_id, state, duplicate}
function officePayRequestDecide_(ctx, data) {
  if (!data.id) throw new Error('MISSING_ID');
  if (typeof data.approve !== 'boolean') throw new Error('BAD_FIELD');
  const r = officePayRequestFind_(data.campus, data.request_id);
  if (officeRows_(r._book, 'PayEvents').some(function (e) { return e.id === String(data.id); })) return { request_id: r.id, state: r.state, duplicate: true };
  if (r.state !== 'requested') throw officeCoded_('ALREADY_DECIDED');
  if (String(r.created_by).toLowerCase() === String(ctx.caller.email).toLowerCase() && ctx.caller.roles.indexOf('Owner') === -1) throw officeCoded_('OWN_ENTRY');
  const reason = String(data.reason || '').trim();
  if (!data.approve && reason.length < 3) throw officeCoded_('REASON_REQUIRED');
  officePayEvent_(ctx, r, data.id, data.approve ? 'approved' : 'rejected', { reason: reason.slice(0, 300) });
  return { request_id: r.id, state: data.approve ? 'approved' : 'rejected', duplicate: false };
}

// {id (this step's), request_id, bank_ref, account (the school's bank account it was paid from), proof_file_id?, paid_date?} -> {request_id, entry_id, proof_pending}
// Writes the bank OUT row. The bank proof is required (audit #9); "proof pending" is left only on requests paid before that rule, which
// payreq.proof completes (the day cannot close meanwhile).
function officePayRequestPaid_(ctx, data) {
  if (!data.id) throw new Error('MISSING_ID');
  const r = officePayRequestFind_(data.campus, data.request_id);
  if (r.state === 'paid') return { request_id: r.id, entry_id: r.entry_id, proof_pending: r.proof_pending, duplicate: true };
  if (r.state !== 'approved') throw officeCoded_('NOT_APPROVED');
  const ref = String(data.bank_ref || '').trim();
  if (ref.length < 3 || ref.length > 60) throw officeCoded_('BANK_REF_REQUIRED');
  const acct = officeAccount_(data.account);
  if (!acct || acct.kind !== 'bank' || acct.campus !== data.campus) throw officeCoded_('BAD_ACCOUNT');
  const proof = officeBlank_(data.proof_file_id) ? '' : String(data.proof_file_id);
  // audit #9 (V2, 28 Nov): every payment has its bank proof when it is marked paid, and the proof is not the bill (payreq.proof only replaces one)
  if (!proof) throw officeCoded_('FILE_REQUIRED');
  if (proof === String(r.file_id)) throw officeCoded_('PROOF_IS_BILL');
  if (!officeFileExists_(data.campus, proof)) throw officeCoded_('FILE_MISSING');
  const date = officeBlank_(data.paid_date) ? officeToday_() : String(data.paid_date);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) throw new Error('BAD_DATE');
  if (date > officeToday_()) throw new Error('FUTURE_DATE');
  const ss = officeOpen_(data.campus, officeFy_(date)), entryId = 'pay-' + r.id;
  officeDaybookWrite_(ss, ctx, { id: entryId, campus: data.campus, entry_date: date, direction: 'OUT', mode: 'bank', bucket: '', category: r.category, amount_paise: r.amount_paise,
    payee: r.payee, narration: (r.narration ? r.narration + ' · ' : '') + 'paid by bank, ref ' + ref, file_id: r.file_id, reverses: '', account: acct.id, charged_to: r.charged_to, source: 'live' }, 'payreq.paid', r.created_by);
  officePayEvent_(ctx, r, data.id, 'paid', { bank_ref: ref, proof_file_id: proof, paid_date: date, entry_id: entryId });
  return { request_id: r.id, entry_id: entryId, proof_pending: !proof, duplicate: false };
}

// {id, request_id, proof_file_id} -> {request_id}: the bank proof (UTR / ICICI confirmation / statement line) for a payment already marked paid
function officePayRequestProof_(ctx, data) {
  if (!data.id) throw new Error('MISSING_ID');
  const r = officePayRequestFind_(data.campus, data.request_id);
  if (r.state !== 'paid') throw officeCoded_('NOT_PAID');
  if (r.proof_file_id) return { request_id: r.id, duplicate: true };
  if (!data.proof_file_id) throw officeCoded_('FILE_REQUIRED');
  if (!officeFileExists_(data.campus, data.proof_file_id)) throw officeCoded_('FILE_MISSING');
  officePayEvent_(ctx, r, data.id, 'proof', { proof_file_id: String(data.proof_file_id) });
  return { request_id: r.id, duplicate: false };
}

// the day close asks: is any payment paid on or before this date still without its bank proof?
function officeProofPending_(campus, date) {
  return officePayRequests_(campus).some(function (r) { return r.proof_pending && r.paid_date <= date; });
}
